{
  "compilerOptions": {
    "jsx": "preserve",
    "strict": true,
    "checkJs": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}