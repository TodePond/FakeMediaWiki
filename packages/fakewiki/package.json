{
	"name": "fakewiki",
	"version": "0.0.13",
	"type": "module",
	"description": "Helpers for making MediaWiki prototypes",
	"license": "GPL-2.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/todepond/FakeMediaWiki.git"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts",
			"default": "./index.ts"
		},
		"./types": {
			"types": "./types.ts",
			"import": "./types.ts",
			"default": "./types.ts"
		},
		"./hooks": {
			"types": "./hooks/index.ts",
			"import": "./hooks/index.ts",
			"default": "./hooks/index.ts"
		},
		"./style/delta.css": "./style/delta.css",
		"./playground-schema": {
			"types": "./playground-schema.generated.ts",
			"import": "./playground-schema.generated.ts",
			"default": "./playground-schema.generated.ts"
		},
		"./playground-overrides": {
			"types": "./playground-overrides.ts",
			"import": "./playground-overrides.ts",
			"default": "./playground-overrides.ts"
		}
	},
	"files": [
		"*.ts",
		"hooks",
		"style",
		"schema",
		"AGENTS.md",
		"scripts"
	],
	"scripts": {
		"generate": "node ../../scripts/build-real-data-reference.mjs && npx tsx scripts/generate-schema.ts",
		"prepublishOnly": "node scripts/verify-root-ts-packed.mjs"
	},
	"peerDependencies": {
		"vue": "^3.5.0",
		"@wikimedia/codex-icons": "^2.0.0"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.1.2",
		"markdown-it": "^14.1.1",
		"markdown-it-anchor": "^9.2.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
