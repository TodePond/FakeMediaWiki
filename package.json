{
  "name": "fake-mediawiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run playground",
    "playground": "npm run generate:playground -w fakewiki",
    "preview": "vite preview",
    "lint": "eslint . --fix --cache && npm run type-check",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write src/",
    "update-ve": "bash scripts/update-ve.sh",
    "bump:patch": "npm version patch -w fakewiki --no-git-tag-version",
    "bump:minor": "npm version minor -w fakewiki --no-git-tag-version",
    "bump:major": "npm version major -w fakewiki --no-git-tag-version",
    "bump": "node -e \"const type=process.env.npm_config_type || 'patch'; if(!['patch','minor','major'].includes(type)){console.error('Usage: npm run bump --type=patch|minor|major'); process.exit(1)}; process.stdout.write(type)\" | xargs -I{} npm run bump:{}",
    "publish": "npm publish -w fakewiki --access public"
  },
  "dependencies": {
    "@wikimedia/codex": "^2.3.3",
    "@wikimedia/codex-design-tokens": "^2.3.3",
    "d3": "^7.9.0",
    "diff-match-patch": "^1.0.5",
    "fakewiki": "workspace:*",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "globals": "^17.0.0",
    "less": "^4.5.1",
    "prettier": "3.7.4",
    "typescript": "^5.7.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^2.2.0"
  }
}
